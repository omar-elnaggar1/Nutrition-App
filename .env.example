# Copy this file to ".env" and fill in real values.
# ".env" is listed in .gitignore, so your secrets are never uploaded to GitHub.

# Your Claude API key from https://console.anthropic.com/ (starts with sk-ant-).
# Paste it straight after the = sign: no spaces, no quotes.
ANTHROPIC_API_KEY=

# Optional settings (the defaults are fine):
# PORT=3000
# SCANS_PER_HOUR=30
# ALLOWED_ORIGINS=https://omar-elnaggar1.github.io
