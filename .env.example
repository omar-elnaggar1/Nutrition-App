# Copy this file to ".env" and fill in real values.
# ".env" is listed in .gitignore, so your secrets are never uploaded to GitHub.

# Port the server listens on.
PORT=3000

# Phase 2 (nutrition label scanning): paste your Claude API key here.
# Get one at https://console.anthropic.com/ — never put it in the public/ folder.
ANTHROPIC_API_KEY=
